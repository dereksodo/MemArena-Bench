# Copy this file to `.env` and fill in the values you need.
# `.env` itself is gitignored — never commit real keys.

# Required for live (non-dry-run) OpenAI-backed runs.
OPENAI_API_KEY=sk-...

# Optional. Raises Semantic Scholar API rate limits during dataset-audit
# tools (scan/repair/validate). Not required for the three test programs.
SEMANTIC_SCHOLAR_API_KEY=

# Optional. scripts/llmjudge.py loads this file automatically and prefers
# OPENROUTER_API_KEY for the OpenRouter gpt-4o-mini judge.
OPENROUTER_API_KEY=

# Optional. For --judge-preset qwen235b. If QWEN235B_BASE_URL points to
# OpenRouter, set this to the same value as OPENROUTER_API_KEY or leave it
# blank so OPENROUTER_API_KEY is used.
QWEN235B_BASE_URL=
QWEN235B_API_KEY=

# Optional self-hosted endpoints (override defaults in config/backend.yaml).
# The accuracy and latency tests talk to an sglang-style server the user
# runs themselves; see config/backend.yaml for the full list.
# Leave blank to use the yaml defaults.
MEMARENA_SGLANG_URL=
MEMARENA_MEMOBASE_URL=
MEMARENA_MEMOS_URL=
