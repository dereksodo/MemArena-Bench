  "@type": "sc:Dataset",
  "name": "MemArena-L",
  "description": "A synthetic benchmark for ego-centric, multi-user, long-horizon memory evaluation in personal agents. MemArena-L contains 50 synthetic agents over 15 simulated days, 13,343 sessions, 137,279 turns, 10,305,361 dialogue-text tokens, and 1,523 evaluation instances across nine released internal task files. Every d4_permission item (paper dimension D6) carries a protected fact and is scored by F1_PU; the generator's 56 fact-less behavioural probes (known-requester ALLOW, anonymous-querier DENY) are not released, since a fact-level judge cannot score them.",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "version": "1.0.0",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://huggingface.co/datasets/dereksodo/memarena-l",
  "datePublished": "2026-05-01",
  "creator": [
    {
      "@type": "Person",
      "name": "Jiadong Zhang",
      "affiliation": "MBZUAI",
      "email": "jiadong.zhang@mbzuai.ac.ae"
    },
    {
      "@type": "Person",
      "name": "Xiaosong Ma",
      "affiliation": "MBZUAI"
    }
  ],
  "publisher": {
    "@type": "Organization",
    "name": "MBZUAI"
  },
  "keywords": [
    "memory",
    "agents",
    "long-context",
    "multi-user",
    "ego-centric",
    "on-device",
    "open-weight",
    "permission-aware",
    "benchmark",
    "synthetic"
  ],
  "citeAs": "@inproceedings{memarena2026,\n  title     = {MemArena: An Ego-Centric Benchmark for On-Device Agentic Personal Memory Assistants at Scale},\n  author    = {Zhang, Jiadong and Ma, Xiaosong},\n  booktitle = {Advances in Neural Information Processing Systems 39 (NeurIPS 2026), Evaluations and Datasets Track},\n  year      = {2026},\n  eprint    = {2608.02613},\n  archivePrefix = {arXiv},\n}",
  "isLiveDataset": false,
  "rai:hasSyntheticData": true,
  "rai:dataLimitations": [
    "Synthetic English text only; no real human conversations are included.",
    "The dataset contains 50 agents and 15 simulated days, so it should not be used for population-level claims or year-long memory claims.",
    "Probe diversity is bounded by the simulator and task extractors.",
    "The released benchmark is intended for evaluation, not model training.",
    "Every d4_permission item (paper dimension D6) carries a protected fact and is scored by F1_PU; the generator's 56 fact-less behavioural probes (known-requester ALLOW, anonymous-querier DENY) are not released, since a fact-level judge cannot score them."
  ],
  "rai:dataBiases": [
    "Dialogue style reflects the simulator and generator model family.",
    "Persona, topic, and location distributions are synthetic and controlled rather than representative of real populations.",
    "The corpus is English-centric."
  ],
  "rai:personalSensitiveInformation": [
    "No real personal information is included.",
    "All personas, events, locations, and sensitive facts are fictional.",
    "Permission-marked utterances are synthetic and included only to evaluate permission-aware behavior."
  ],
  "rai:dataUseCases": [
    "Benchmark memory-augmented agents on long-horizon ego-centric recall.",
    "Compare retrieval, context, and structured-memory backends.",
    "Evaluate abstention and permission-aware access under multi-user personal memory."
  ],
  "rai:dataSocialImpact": "The dataset supports controlled evaluation of personal-agent memory under privacy-aware, ego-centric conditions. Misuse risk: using the evaluation text as training data may contaminate benchmark comparisons or teach undesirable disclosure behavior.",
  "prov:wasDerivedFrom": [
    {
      "@id": "MASim/configs/reviewed_personas_l.jsonl",
      "description": "Reviewed persona pool used by the MASim simulator."
    },
    {
      "@id": "MASim/data/activity_topics.yaml",
      "description": "Activity-topic ontology used by the simulator's event and session scheduler."
    }
  ],
